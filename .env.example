OPENAI_API_KEY=your-openai-api-key
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

OPENAI_MODEL=gpt-4o-mini
OPENAI_INTENT_MODEL=gpt-4o-mini
OPENAI_MAX_COMPLETION_TOKENS=40
OPENAI_LLM_TEMPERATURE=0.2
FSM_INTENT_TIMEOUT_SECONDS=5.0
VOICE_PIPELINE_MODE=controlled_fast
OPENAI_STT_MODEL=gpt-4o-transcribe-diarize
OPENAI_FAST_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_FAST_STT_REALTIME=true
OPENAI_FAST_STT_TURN_SILENCE_MS=400
OPENAI_FAST_STT_PREFIX_PADDING_MS=300
OPENAI_FAST_STT_VAD_THRESHOLD=0.70
OPENAI_STT_LANGUAGE=es
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_TTS_RESPONSE_FORMAT=pcm
OPENAI_TTS_SPEED=1.05
OPENAI_TTS_INSTRUCTIONS=Habla en español de España, con un tono natural, profesional y claro para atención al cliente.
AGENT_INSTRUCTIONS_FILE=prompts/collections-es.md
FSM_ENABLED=true
FSM_AUTO_OPENING_ENABLED=true
CASE_CONTEXT_FILE=examples/collections/al-corriente.case.json
FSM_TRACE_PATH=logs/fsm-adherence.jsonl
SILERO_VAD_ACTIVATION_THRESHOLD=0.70
SILERO_VAD_DEACTIVATION_THRESHOLD=0.50
SILERO_VAD_MIN_SPEECH_SECONDS=0.40
SILERO_VAD_MIN_SILENCE_SECONDS=0.65
SILERO_VAD_PREFIX_PADDING_SECONDS=0.30

BARGE_IN_ENABLED=true
BARGE_IN_TURN_DETECTION_MODE=auto
BARGE_IN_ENDPOINTING_MODE=dynamic
BARGE_IN_INTERRUPTION_MODE=vad
BARGE_IN_MIN_SPEECH_SECONDS=0.50
BARGE_IN_MIN_WORDS=2
BARGE_IN_FALSE_INTERRUPTION_TIMEOUT_SECONDS=2.0
BARGE_IN_RESUME_FALSE_INTERRUPTION=true
BARGE_IN_MIN_ENDPOINTING_DELAY_SECONDS=0.40
BARGE_IN_MAX_ENDPOINTING_DELAY_SECONDS=1.20
BARGE_IN_MIN_CONSECUTIVE_SPEECH_DELAY_SECONDS=0.20
BARGE_IN_PREEMPTIVE_GENERATION=false
BARGE_IN_USER_AWAY_TIMEOUT_SECONDS=30
BARGE_IN_CONFIRMATION_GRACE_SECONDS=6.0
BARGE_IN_IMMEDIATE_MUTE_ENABLED=false
BARGE_IN_NATIVE_INTERRUPTION_ENABLED=true
BARGE_IN_SOFT_PAUSE_ENABLED=true
BARGE_IN_SOFT_RECOVERY_DELAY_SECONDS=1.50
AEC_WARMUP_SECONDS=8.0
ECHO_GUARD_POST_SPEECH_SECONDS=1.2
BARGE_IN_TELEMETRY_PATH=logs/barge-in-telemetry.jsonl
BARGE_IN_SQLITE_PATH=logs/barge-in-telemetry.sqlite3
VOICE_METRICS_TELEMETRY_PATH=logs/voice-metrics-telemetry.jsonl
VOICE_METRICS_SQLITE_PATH=logs/voice-metrics-telemetry.sqlite3
